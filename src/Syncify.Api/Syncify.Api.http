@Syncify.Api_HostAddress = http://127.0.0.1:5050

GET {{Syncify.Api_HostAddress}}/health
Accept: application/json

###

# Development only. Needs YouTube:ApiKey in user-secrets. Takes a playlist ID or link.
GET {{Syncify.Api_HostAddress}}/dev/youtube/playlist?link=https://www.youtube.com/playlist?list=PLOp8kZQdZGQs
Accept: application/json

###

# Development only. Needs YouTube:ApiKey, Spotify:ClientId and Spotify:ClientSecret in user-secrets.
# Searches Spotify for every video (one or two searches each), so a 300-video playlist takes a few seconds.
GET {{Syncify.Api_HostAddress}}/dev/preview?link=PLOp8kZQdZGQs
Accept: application/json

###
